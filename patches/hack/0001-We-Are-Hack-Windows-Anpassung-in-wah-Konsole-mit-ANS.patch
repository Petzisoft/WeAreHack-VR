diff --git a/wah/term.h b/wah/term.h
new file mode 100644
index 0000000..b26d7fb
--- /dev/null
+++ b/wah/term.h
@@ -0,0 +1,17 @@
+/* We Are Hack, 2026-11-23: minimal terminfo <term.h> for Windows (Hack 1.0.3 port). Not part of the original Hack.
+ * The capabilities are fixed ANSI/VT sequences; the Windows console understands them once
+ * ENABLE_VIRTUAL_TERMINAL_PROCESSING is on (set in setupterm, wah_term.c). The screen therefore
+ * lands in a real console buffer, which the We Are Hack bridge reads (80x25). */
+#ifndef WAH_TERM_H
+#define WAH_TERM_H
+
+extern int columns, lines;
+extern const char *clear_screen, *cursor_address, *cursor_up, *cursor_home, *cursor_right,
+	*cursor_left, *clr_eol, *clr_eos, *enter_standout_mode, *exit_standout_mode;
+extern int over_strike, magic_cookie_glitch;
+
+int setupterm(const char *term, int fd, int *err);
+int tputs(const char *s, int affcnt, int (*outc)(int));
+char *tiparm(const char *cap, ...);
+
+#endif
