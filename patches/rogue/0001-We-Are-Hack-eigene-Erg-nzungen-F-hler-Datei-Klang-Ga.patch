+
+/*
+ * fuehler_schreiben:
+ *	We Are Hack (3D-Ansicht): schreibt vor jedem Befehl die Werte aller
+ *	Monster dieser Ebene in %TEMP%\wearehack_monster.txt, damit die
+ *	Grafik Lebenspunkte und Zustand zeigen kann. Am Spielablauf aendert
+ *	sich dadurch nichts.
+ *	Zeile 1: ebene <nr> held <0|1> hp <aktuell> <max>
+ *	Dann Zeilen "spieler ...", "ausruestung ...", "ort ...", je Gegenstand
+ *	"ding x y typ art". Danach je Monster: x y buchstabe lp max_lp flags tarnung
+ */
+int klang_nr = 0;		/* We Are Hack: zaehlt Waffenereignisse fuer den Ton */
+char klang_text[120] = "";
+
+void
+klang(char *art, int waffe, char *ergebnis)
+{
+    klang_nr++;
+    sprintf(klang_text, "%.20s %d %.20s", art, waffe, ergebnis);
+}
+
+/* We Are Hack: Gang vor dem Spieler (nur echte Gaenge, keine geheimen), damit die 3D-Ansicht weiter sehen kann */
+static char gang_tiefe[NUMLINES][NUMCOLS];
+
+static void
+gang_melden(FILE *f, int y, int x, int d)
+{
+    int dy, dx, ny, nx;
+    char ch;
+
+    if (d > 4)
+	return;
+    for (dy = -1; dy <= 1; dy++)
+	for (dx = -1; dx <= 1; dx++)
+	{
+	    ny = y + dy;
+	    nx = x + dx;
+	    if (ny < 1 || ny >= NUMLINES - 1 || nx < 0 || nx >= NUMCOLS)
+		continue;
+	    if (gang_tiefe[ny][nx] <= d || !(flat(ny, nx) & F_REAL))
+		continue;
+	    ch = chat(ny, nx);
+	    if (ch != PASSAGE && ch != DOOR)
+		continue;
+	    gang_tiefe[ny][nx] = (char) d;
+	    fprintf(f, "gang %d %d %d\n", nx, ny, d);
+	    if (ch == PASSAGE)
+		gang_melden(f, ny, nx, d + 1);
+	}
+}
+
+static void
+fuehler_schreiben(void)
+{
+    static char pfad[512];
+    FILE *f;
+    THING *tp;
+    char *tmp;
+
+    if (pfad[0] == '\0')
+    {
+	tmp = getenv("TEMP");
+	sprintf(pfad, "%.480s/wearehack_monster.txt", tmp != NULL ? tmp : ".");
+    }
+    if ((f = fopen(pfad, "w")) == NULL)
+	return;
+    fprintf(f, "ebene %d held %d hp %d %d\n", level, on(player, ISHELD) ? 1 : 0,
+	pstats.s_hpt, max_hp);
+    fprintf(f, "spieler tiefste %d kraft %d %d ruestung %d stufe %d erfahrung %d gold %d hunger %d flags %d amulett %d\n",
+	max_level, (int) pstats.s_str, (int) max_stats.s_str,
+	cur_armor != NULL ? cur_armor->o_arm : pstats.s_arm,
+	pstats.s_lvl, pstats.s_exp, purse, hungry_state, (int) player.t_flags,
+	amulet ? 1 : 0);
+    fprintf(f, "ausruestung waffe %d ruestung %d\n",
+	cur_weapon != NULL ? cur_weapon->o_which : -1,
+	cur_armor != NULL ? cur_armor->o_which : -1);
+    if (klang_nr > 0)
+	fprintf(f, "klang %d %s\n", klang_nr, klang_text);
+    if (chat(hero.y, hero.x) == PASSAGE || chat(hero.y, hero.x) == DOOR)
+    {
+	memset(gang_tiefe, 99, sizeof gang_tiefe);
+	gang_tiefe[hero.y][hero.x] = 0;
+	gang_melden(f, hero.y, hero.x, 1);
+    }
+    fprintf(f, "ort x %d y %d dunkel %d gang %d\n", hero.x, hero.y,
+	proom != NULL && (proom->r_flags & ISDARK) ? 1 : 0,
+	proom != NULL && (proom->r_flags & ISGONE) ? 1 : 0);
+    for (tp = lvl_obj; tp != NULL; tp = next(tp))
+	fprintf(f, "ding %d %d %c %d\n", tp->o_pos.x, tp->o_pos.y, tp->o_type, tp->o_which);
+    for (tp = mlist; tp != NULL; tp = next(tp))
+	fprintf(f, "%d %d %c %d %d %d %c\n", tp->t_pos.x, tp->t_pos.y, tp->t_type,
+	    tp->t_stats.s_hpt, tp->t_stats.s_maxhp, (int) tp->t_flags,
+	    tp->t_disguise ? tp->t_disguise : '-');
+    fclose(f);
+}
