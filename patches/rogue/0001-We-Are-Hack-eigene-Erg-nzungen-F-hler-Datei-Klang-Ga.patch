--- a/fight.c
+++ b/fight.c
@@ -104,6 +104,7 @@ fight(coord *mp, THING *weap, bool thrown)
     has_hit = (terse && !to_death);
     if (roll_em(&player, tp, weap, thrown))
     {
+	klang(thrown ? "wurf" : "hieb", weap != NULL ? weap->o_which : -1, "treffer");
 	did_hit = FALSE;
 	if (thrown)
 	    thunk(weap, mname, terse);
@@ -125,10 +126,13 @@ fight(coord *mp, THING *weap, bool thrown)
 	did_hit = TRUE;
     }
     else
+    {
+	klang(thrown ? "wurf" : "hieb", weap != NULL ? weap->o_which : -1, "daneben");
 	if (thrown)
 	    bounce(weap, mname, terse);
 	else
 	    miss((char *) NULL, mname, terse);
+    }
     return did_hit;
 }
 
